{
  "deno.enable": true,
  "deno.config": "./deno.json",
  "deno.enablePaths": ["./"],
  "deno.lint": true,
  "deno.codeLens.test": true,
  "deno.codeLens.implementations": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "denoland.vscode-deno",
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[javascript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  }
}
